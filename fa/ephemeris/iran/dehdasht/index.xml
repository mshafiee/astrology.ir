	&lt;div id="osm-map">&lt;/div>
	&lt;script>
		var element = document.getElementById('osm-map');
		element.style = 'border: 1px solid #AAA; width:100%; height:300px';
		var map = L.map(element);
		L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', {
			attribution: '&lt;div dir="ltr">Dehdasht, Iran | &amp;copy; &lt;a href="https://astrology.ir/">astrology.ir&lt;/a>&lt;/div>'
		}).addTo(map);
		map.attributionControl.setPrefix(false);
		var target = L.latLng('30.7949', '50.5646');
		map.setView(target, "12");
		L.marker(target).addTo(map);
	&lt;/script>
