&lt;div class="shortcode shortcode-osm-maps">
	&lt;script src="https://unpkg.com/leaflet@1.9.1/dist/leaflet.js">&lt;/script>
	&lt;link href="https://unpkg.com/leaflet@1.9.1/dist/leaflet.css" rel="stylesheet"/>
	&lt;div id="osm-map">&lt;/div>
	&lt;script>
		var element = document.getElementById('osm-map');
		element.style = 'border: 1px solid #AAA; width:100%; height:300px';
		var map = L.map(element);
		L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', {
			attribution: '&lt;div dir="ltr">Shabestar, Iran | &amp;copy; &lt;a href="https://astrology.ir/">astrology.ir&lt;/a>&lt;/div>'
		}).addTo(map);
		map.attributionControl.setPrefix(false);
		var target = L.latLng('38.1804', '45.7028');
		map.setView(target, "12");
		L.marker(target).addTo(map);
	&lt;/script>
&lt;/div>
